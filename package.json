    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "3.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.7",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "3.2.6",
    "zod": "4.1.12"
  }
}
